{
  "name": "@aurigax-ai/wire",
  "version": "0.1.6",
  "description": "A state graph interpreter for long external activities: agents, humans and commands, with a journal and reattach",
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aurigax-ai/wire.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src",
    "fixtures",
    "docs",
    "CONTRACT.md",
    "SECURITY.md",
    "!src/**/*.test.ts",
    "!dist/**/*.test.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "wire": "./dist/cli/bin.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "croner": "10.0.1",
    "picomatch": "4.0.7",
    "vscode-jsonrpc": "9.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@marcbachmann/cel-js": "8.0.0",
    "@types/node": "24.19.1",
    "@types/picomatch": "4.0.3",
    "ajv": "8.20.0",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
