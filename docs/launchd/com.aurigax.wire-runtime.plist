<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aurigax.wire-runtime</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/opt/homebrew/lib/node_modules/@aurigax-ai/wire/dist/cli/bin.js</string>
    <string>runtime</string>
    <string>start</string>
